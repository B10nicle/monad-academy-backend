<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="06-create-submissions" author="monad-academy-agent">
		<createTable schemaName="monad_academy" tableName="submissions">
			<column name="id" type="uuid">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="user_id" type="uuid">
				<constraints nullable="false"/>
			</column>
			<column name="task_id" type="uuid">
				<constraints nullable="false"/>
			</column>
			<column name="source_code" type="text">
				<constraints nullable="false"/>
			</column>
			<column name="status" type="varchar(32)">
				<constraints nullable="false"/>
			</column>
			<column name="execution_metadata" type="text"/>
			<column name="execution_duration_ms" type="bigint"/>
			<column name="created_at" type="timestamp with time zone">
				<constraints nullable="false"/>
			</column>
			<column name="updated_at" type="timestamp with time zone">
				<constraints nullable="false"/>
			</column>
		</createTable>

		<addForeignKeyConstraint
				baseTableName="submissions"
				baseTableSchemaName="monad_academy"
				baseColumnNames="user_id"
				constraintName="fk_submissions_user"
				referencedTableName="users"
				referencedTableSchemaName="monad_academy"
				referencedColumnNames="id"
				onDelete="CASCADE"/>

		<addForeignKeyConstraint
				baseTableName="submissions"
				baseTableSchemaName="monad_academy"
				baseColumnNames="task_id"
				constraintName="fk_submissions_task"
				referencedTableName="tasks"
				referencedTableSchemaName="monad_academy"
				referencedColumnNames="id"
				onDelete="CASCADE"/>

		<createIndex schemaName="monad_academy" tableName="submissions" indexName="idx_submissions_user_id">
			<column name="user_id"/>
		</createIndex>

		<createIndex schemaName="monad_academy" tableName="submissions" indexName="idx_submissions_task_id">
			<column name="task_id"/>
		</createIndex>

		<createIndex schemaName="monad_academy" tableName="submissions" indexName="idx_submissions_status">
			<column name="status"/>
		</createIndex>

		<createIndex schemaName="monad_academy" tableName="submissions" indexName="idx_submissions_user_task_created_at">
			<column name="user_id"/>
			<column name="task_id"/>
			<column name="created_at"/>
		</createIndex>
	</changeSet>
</databaseChangeLog>
